# Puede apuntar a un estilo compatible con MapLibre. Si queda vacío,
# la demo usa mosaicos raster de OpenStreetMap con atribución visible.
VITE_MAP_STYLE_URL=

# Preparado para V0.2. Respetar la política del proveedor y sus límites.
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org

# Preparado para V0.4. No se fija un proveedor definitivo en V0.1.
VITE_ROUTING_URL=

# Backend futuro. Nunca guardar secretos en variables VITE_*.
VITE_API_URL=
